html/
node_modules/
html_db/
tmp/

# Large local RAG/model artifacts
simg_zmq/rag/data/chroma/
simg_zmq/rag/qwn_kk_fine_model/
simg_zmq/rag/tools/
simg_zmq/rag/*.simg.filepart
simg_zmq/rag/model/*.gguf
simg_zmq/rag/embding_mod/*

# HPCC runtime-generated directories (created by main_hpcc.sh at startup)
simg_zmq/logs/
simg_zmq/runtime_state/
simg_zmq/runtime_local/

# Build manifest (regenerated by generate_upload.py)
.metadata.json

# Deployment credentials
.env
*.env
.env*
!.env.example
*.simg

# Generated deployment folder (regenerated by generate_upload.py)
generate_upload/

# --- chunk-push hygiene (<90MB, code-only, no LFS, low-net) ---
# Data / trace (never push raw)
*.h5
*.hdf5
*.hdf
*.mf4
*.mdf4
*.blf
*.asc
# Binaries / models (never push)
*.fmu
*.gguf
*.safetensors
*.dll
*.exe
*.lib
*.a
*.pdb
*.bin
*.so.*
# Heavy configs / dumps (code-only push skips these)
*.arxml
*.ipch
*.eapx
# Research: ignore everything by default, curated code added with `git add -f`
Research/
# Dup / mirror outputs
simg_zmq/rag/model/
simg_zmq/generate_upload/
simg_zmq/.store/
simg_zmq/main_html/simg/
edge_hdf/can/input/
edge_hdf/can/output/
edge_hdf/udp/input/
edge_hdf/udp/output/
**/*.bkp
**/.*.bkp
.pytest_cache/
**/.pytest_cache/
# Windows copy dupes like "file (1).h5"
**/*(*).h5