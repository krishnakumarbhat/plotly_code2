            "args": ["C:/Plastic/10028634_01_SRR_RESIM_Release/RESIM_SIL/GEN7_SIL_ENGINE/SIL_Engine_Config.xml", "C:/Plastic/10028634_01_SRR_RESIM_Release/RESIM_SIL/GEN7_SIL_ENGINE/SIL_Input_Logs.txt"],
