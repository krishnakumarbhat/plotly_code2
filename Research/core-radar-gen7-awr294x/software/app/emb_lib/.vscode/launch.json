    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "/media/aptiv/DATADRIVE2/wkspace/10028634_01_SRR_RESIM_Release/RESIM_SIL/GEN7_SIL_ENGINE/APT_SRR_RESIM",
            "args": ["SIL_Engine_Config.xml", "SIL_Input_Logs.txt"],
            "stopAtEntry": false,
            "cwd": "/media/aptiv/DATADRIVE2/wkspace/10028634_01_SRR_RESIM_Release/RESIM_SIL/GEN7_SIL_ENGINE",
            "environment": [{
                "name": "LD_LIBRARY_PATH",
                "value": "/media/aptiv/DATADRIVE2/wkspace/10028634_01_SRR_RESIM_Release/RESIM_SIL/GEN7_SIL_ENGINE",
            }],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Add source path",
                    "text": "directory ${workspaceFolder}"
                }
            ]
        },
        {
            "name": "(gdb) Windows",
            "type": "cppdbg",
