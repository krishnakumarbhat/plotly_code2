CM_ BO_ 1  "The CAN message from the Time Master is a multiplexed message, viz. CAN-SYN and CAN-FUP";

CM_ SG_ 256 DET_RANGE_001 " measured position  of the detection";
CM_ SG_ 256 DET_RANGE_ERR_001 "RMSE or standard deviation of the measured angle  of the detection";
CM_ SG_ 256 DET_RANGE_VELOCITY_001 "Radial velocity of the detection positive in direction to the sensor";
CM_ SG_ 256 DET_RANGE_VELOCITY_ERR_001 "RMSE or standard deviation of the measure radial velocity of the detection";
CM_ SG_ 256 DET_AZIMUTH_001 "Measured angle  of the detection";
CM_ SG_ 256 DET_AZIMUTH_ERR_001 "RMSE or standard deviation of the measured angle  of the detection";
CM_ SG_ 256 DET_ELEVATION_001 "measured elevation of the detection";
CM_ SG_ 256 DET_ELEVATION_ERR_001 "RMSE or standard deviation of the measured elevation  of the detection";
CM_ SG_ 256 DET_RCS_001 "Radar Cross Section or Amplitude, is a measure of how detectable an object is by radar. A larger RCS indicates that an object is more easily detected.";
CM_ SG_ 256 DET_VALID_FLAG_001 "is set if the measured detection is valid";
CM_ SG_ 256 DET_BI_STATIC_FLAG_001 "1 if detection is bi-static 0 otherwise";
CM_ SG_ 256 DET_SUPER_RES_TARGET_001 "flasg is set if the detection is super resolution target";
CM_ SG_ 256 DET_SNR_001 "The signal to noise ratio (SNR) of the radar detection";
CM_ SG_ 256 DET_POINT_TARGET_PROB_001 "Describes the possibility if more than one real-world object has led to this detection. 0[%] := 100[%] Multi target probability";
CM_ SG_ 256 DET_EXISTENCE_PROB_001 "Existence probability of the detection not based on history. Value does  not depend on any past experience with similar detections.
\note Use as confidence measure where a low value means less confidence
and a high value indicates strong confidence.";
CM_ SG_ 256 DET_OUTSIDE_SECTOR_001 "Flag to indicate detections outside the sector, set if the wrong sector calibration matrix was used";
CM_ SG_ 256 DET_HVC_FLAG_001 "Core2 Vehicle clutter flag";
CM_ SG_ 256 DET_CONFD_AZIMUTH_001 "Define the Confidence of Azimuth for Detection ";
CM_ SG_ 256 DET_CONFD_ELEVATION_001 "Define the Confidence of Elevation for the Detection ";
CM_ SG_ 256 DET_AZIMUTH_AMB_ID_001 "Each ambiguous measurement generates one Ambiguity ID. Ambiguity is indicated by an identical ambiguity ID.
note Unambiguous measurements have the ambiguity ID 0.";
CM_ SG_ 256 DET_AMBG_AZIMUTH_PROB_001 "Probability for different hypothesis, sum is 100 [%] for all detections with the same Ambiguity ID. 0 means no Ambiguity";
CM_ SG_ 256 DET_BI_STATIC_FLAG_002 "1 if detection is bi-static 0 otherwise";
CM_ SG_ 256 DET_BI_STATIC_FLAG_003 "1 if detection is bi-static 0 otherwise";
CM_ SG_ 256 DET_BI_STATIC_FLAG_004 "1 if detection is bi-static 0 otherwise";
CM_ SG_ 256 DET_MH_SCAN_INDEX_4LSB_001_004 "Scan index of the measured detection";
CM_ SG_ 256 DET_MH_CYCLE_COUNTER_001_004 "Detection Alive Counter";
CM_ SG_ 1 TSYN_USERBYTE "User specific data within the time measurement and synchronization protocol";
CM_ SG_ 1 TSYN_TIMEDOMAIN "Time Domian ID";
CM_ SG_ 1 TSYN_SYNCTIME_SEC "TIme in Seconds";
CM_ SG_ 1 TSYN_SYNCTIME_NANOSEC "Time in Nano Seconds";
CM_ SG_ 1 TSYN_SGW "Sync to Global Time or Sync to Sub Domian";
CM_ SG_ 1 TSYN_SEQUENCE_COUNTER "Sequence Counter (SC) of 4 bit is representing numbers from 0 to 15 per Time
Domain";
CM_ SG_ 1 TSYN_RESERVED "resreved for future extension";
CM_ SG_ 1 TSYN_PDU "TSyn_PDU signal value of 0x20 is  CAN-SYN. and TSyn_PDU signal value of 0x28 is CAN-FUP";
CM_ SG_ 1 TSYN_OVS "Overflow of seconds. If the value calculated for TSyn_SynTimeNSec overflows";
CM_ SG_ 1 TSYNC_CRC "CRC CRC8H2F";
CM_ SG_ 2 SSTS_YAW_RATE_CALC_QF "Yaw Rate quallity factor";
CM_ SG_ 2 SSTS_VEHICLE_SPEED_CALC_QF "Speed Quality factor";
CM_ SG_ 2 SSTS_VEH_BATT_VOLT "absolute battery voltage";
CM_ SG_ 2 SSTS_PWPCKTQ_D_STAT "Indicates if the power pack is a motive (wheel torque producing) or non-motive (non-wheel torque producing) mode. It also indicates to if a transition from a non-motive to a motive mode is in progress.";
CM_ SG_ 2 SSTS_CC_STAT_D_ACTL "Status of cruise  controls.";
CM_ SG_ 2 SSTS_ElPW_D_STAT "Indicates if the power pack is supporting the 12V bus with energy, supporting but about to stop, not supporting and undergoing a large power draw (e.g. starting MHEV ICE), or in a fault limited support mode.";
CM_ SG_ 2 SSTS_VEHOVERGND_V_EST "Estimated vehicle speed over ground.";
CM_ SG_ 2 SSTS_STEERING_ANGLE_SIGN "Actual steering angle direction, from the centre position of the steering wheel.";
CM_ SG_ 2 SSTS_STEERING_ANGLE "Actual steering wheel angle. Datum (zero) of the steering wheel position is determined at the time of calibration in the factory.   This is only the magnitude of the steering wheel angle.";
CM_ SG_ 133 STS_TIME_STAMP_DELTA "Difference between last Timestamp and internal Timer";
CM_ SG_ 133 STS_SW_VERSION_FIELD1 "Release_Number is incremented for major every release";
CM_ SG_ 133 STS_SW_VERSION_FIELD2 "Promote_Revision, increment with every promote or minor release";
CM_ SG_ 133 STS_SW_VERSION_FIELD3 "Field_Revision  or Variant number";
CM_ SG_ 133 STS_SW_VERSION_FIELD4 "Increment with SW patch release";
CM_ SG_ 133 STS_PBL_VERSION_FIELD1 "Release_Number is incremented for major every release";
CM_ SG_ 133 STS_PBL_VERSION_FIELD2 "Promote_Revision, increment with every promote or minor release";
CM_ SG_ 133 STS_PBL_VERSION_FIELD3 "Field_Revision  or Variant number";
CM_ SG_ 133 STS_PBL_VERSION_FIELD4 "Increment with patch release";
CM_ SG_ 133 STS_SMC_SECTION_COMPTBLITY "Section compatiblity bits as specified in EXEC spec";
CM_ SG_ 133 STS_SMC_PLATFROM_VERSION "Variant ID";
CM_ SG_ 133 STS_SENSOR_MOUNT_POS_X "Correction of the mounting position w.r.t. the optimal position. Correction is determined by calibration";
CM_ SG_ 133 STS_SENSOR_MOUNT_ORNT_PITCH "Correction of the mounting position orientation w.r.t. the optimal orientation";
CM_ SG_ 133 STS_SENSOR_HEIGHT "Radar height from ground to center of radar elevation field-of-view";
CM_ SG_ 133 STS_DET_DBC_BASE_VER_MINOR "Detection base dbc Minor version";
CM_ SG_ 133 STS_DET_DBC_BASE_VER_MAJOR "Detection base dbc Major version";
CM_ SG_ 134 STS_TIMESYNC_JITTER "Delay between sync and FUL";
CM_ SG_ 134 STS_TIMESYNC_CORRECTION_TYP "Time adjustment type";
CM_ SG_ 134 STS_POINT_OF_TRIGGER "Delay betwen TymSyc message received and actual trigger";
CM_ SG_ 134 STS_THRESHOLD_FLAG "Set if time difference between SYNC and FLUP Time is greater than threshhold value";
CM_ SG_ 134 STS_BRR_STATUS "Current status of BRR , active/inactive/fault";
CM_ SG_ 134 STS_VEH_CRD_SYS_TYPE "Defines the reference vehicle coordinate system for the interface of a sensor.";
CM_ SG_ 134 STS_NUM_VALID_FOV_RR "The current number of valid field of view reduction reasons";
CM_ SG_ 134 STS_NUM_VALID_FOV_RR_TYPE "Field of view reduction reason ";
CM_ SG_ 134 STS_NUM_VALID_FOV_RR_PROB "Field of view reduction reason probability";
CM_ SG_ 134 STS_BOARD_THERMISTOR "On Board Thermistor Temperature";
CM_ SG_ 134 STS_MMIC0_TEMP_TX1 "Internal MMIC Temperature #1";
CM_ SG_ 134 STS_PROCESSOR_Temp1 "Internal Micro Temperature #1";
CM_ SG_ 134 STS_XCVR_OPERATIONAL "Indication that the transceiver is operational";
CM_ SG_ 134 STS_VEH_SPEED_DIRECTION "Provides indication of vehicle direction of travel";
CM_ SG_ 134 STS_RADIUS_CURVATURE "vehicle turning radius";
CM_ SG_ 134 STS_STEERING_ANGLE_SIGN "Actual steering angle direction, from the centre position of the steering wheel.";
CM_ SG_ 134 STS_STEERING_ANGLE "Actual steering wheel angle. Datum (zero) of the steering wheel position is determined at the time of calibration in the factory.   This is only the magnitude of the steering wheel angle.";
CM_ SG_ 134 STS_YAW_RATE_CALC "yawrate";
CM_ SG_ 134 STS_VEHICLE_SPEED_CALC "Vehicle speed";
CM_ SG_ 134 STS_TIME_SYNC_OFFSET "Current offset from desired Time Sync Sync point";
CM_ SG_ 128 HED_NUM_OF_VALID_DETECTIONS "The current number of valid detections in the detections list";
CM_ SG_ 128 HED_INTRFC_VERSION_ID_MAJOR "Version number for major";
CM_ SG_ 128 HED_INTRFC_VERSION_ID_MINOR "Version number for minor";
CM_ SG_ 128 HED_INTRFC_VERSION_ID_PATCH "Version number for patch";
CM_ SG_ 128 HED_LOOK_ID "Indicates the look type values 1 to 4 base on medium/long look and near/far look. Each radar scan is a look.";
CM_ SG_ 128 HED_CAN_SCAN_INDEX "Scan index";
CM_ SG_ 128 HED_MH_CYCLE_COUNTER "ALIVE counter";
CM_ SG_ 128 HED_DATA_QUALIFIER "Data qualifier communicates the overall availability of the interface or expresses to what extent the content of this event can be relied on ";
CM_ SG_ 128 HED_DET_RANGE_MAX "Detection range max is the farthest possible detection with respect to the sensor origin.";
CM_ SG_ 128 HED_DET_SPEED_RANGE_MAX "Describes the relative radial speed range in the sensor coordinate system. Range is defined by
two range values: negative values indicate lower speed than the ego-vehicle, positive values
indicate higher velocity than ego-vehicle";
CM_ SG_ 128 HED_FOV_HOR_MAX "Field of view defined by opening angles in sensor XY-plane.";
CM_ SG_ 128 HED_FOV_VER_MAX "Field of view defined by opening angles in sensor XZ-plane.";
CM_ SG_ 128 HED_DET_RANGE_MIN "Detection range max is the Closest possible detection with respect to the sensor origin.";
CM_ SG_ 128 HED_DET_SPEED_RANGE_MIN "Describes the relative radial speed range in the sensor coordinate system. Range is defined by
two range values: negative values indicate lower speed than the ego-vehicle, positive values
indicate higher velocity than ego-vehicle";
CM_ SG_ 128 HED_FOV_HOR_MIN "Field of view defined by opening angles in sensor XY-plane.";
CM_ SG_ 128 HED_FOV_VER_MIN "Field of view defined by opening angles in sensor XZ-plane.";
CM_ SG_ 128 HED_ALIGN_VER_ANGLE "Alighnment vertical angle";
CM_ SG_ 128 HED_ALIGN_HOR_ANGLE "Alighnment horizontal angle";
CM_ SG_ 128 HED_ALIGN_HOR_REF "Alignment horizontal reference";
CM_ SG_ 128 HED_ALIGN_HOR_QF "Alignment horizontal calibration status";
CM_ SG_ 128 HED_AF_TIME_PEAK "Angle Finding Latency peak";
