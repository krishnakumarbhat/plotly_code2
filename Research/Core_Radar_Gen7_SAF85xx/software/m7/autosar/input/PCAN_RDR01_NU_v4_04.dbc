CM_ SG_ 132 STS_INTRFC_VERSION_ID_MAJOR "Version number for major";
CM_ SG_ 132 STS_POINT_OF_TRIGGER "Delay betwen TymSyc message received and actual trigger";
CM_ SG_ 132 STS_BRR_STATUS "Current status of BRR , active/inactive/fault";
CM_ SG_ 132 STS_MMIC_TEMP_TX1_2 "Internal MMIC Temperature #1";
CM_ SG_ 132 STS_XCVR_OPERATIONAL "Indication that the transceiver is operational";
CM_ SG_ 132 STS_VEH_SPEED_DIRECTION "Provides indication of vehicle direction of travel";
CM_ SG_ 132 STS_STEERING_ANGLE_SIGN "Actual steering angle direction, from the centre position of the steering wheel.";
