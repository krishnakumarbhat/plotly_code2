CM_ SG_ 131 STS_PBL_VERSION_FIELD4 "Increment with patch release";
CM_ SG_ 131 STS_SMC_SECTION_COMPTBLITY "Section compatiblity bits as specified in EXEC spec";
CM_ SG_ 131 STS_SMC_PLATFROM_VERSION "Variant ID";
