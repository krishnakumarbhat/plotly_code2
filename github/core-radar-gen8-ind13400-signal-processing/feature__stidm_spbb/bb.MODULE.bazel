    integrity = "sha256-op3gt+39an9saQBukpi0qtoAXUVagyB89rYjZyIbsKg=",
    urls = ["https://jfrog.asux.aptiv.com/artifactory/core_radar-aptiv-00000000-building_blocks-local/Core_Radar_Gen8_iND13400_SDK/v3/Core_Radar_Gen8_iND13400_SDK_v3.52.45.zip"],
