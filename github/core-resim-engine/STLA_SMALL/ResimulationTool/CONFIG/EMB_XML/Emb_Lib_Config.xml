		<DEBUG_DETECTION_GROUPS>1</DEBUG_DETECTION_GROUPS>
		<FEATURES>1</FEATURES>
		<LCDA>1</LCDA>
		<RECW>1</RECW>
		<CTA>1</CTA>
		<ASW>1</ASW>
		<VISOB>1</VISOB>
		<Freespace>1</Freespace>
