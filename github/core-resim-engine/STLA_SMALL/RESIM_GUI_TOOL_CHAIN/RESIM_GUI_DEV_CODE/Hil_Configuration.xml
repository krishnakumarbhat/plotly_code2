
<?xml version="1.0" encoding="UTF - 8" ?> 
<!-- SRR5 APTIV HIL component configuration -->
<HIL_SRR5_Configuration>
	<!-- HIL SRR5 Configuration XML version -->
	<!-- Version X.Y where:
		X - major change where some new parameters were added
		Y - minor change with no influence on parsing (comment or value change) -->	
    <HIL_SRR_Configuration_XML_Version>6.0</HIL_SRR_Configuration_XML_Version>
	
	<!-- To define the CUSTOMER for which the HIL is Executed. 
		 Options available are: SRR5: GEELY_SRR5,HKMC_SRR5,RNA_SUV,RNA_CDV,BMW_LOW,BMW_SAT,BMW_BPIL,BMW_HIGH -->
								<!-- Defined in enum Customer_T in Radar_Config.h -->
	<CUSTOMER_NAME>HKMC_SRR5</CUSTOMER_NAME>
	
	<!--UDP_REC_VER_INFO>A318</UDP_REC_VER_INFO> <!--A318 or A218 or A118-->
	
	<!-- Sensor selection values: 1 => Sensor Connected , Resim is executed for that Sensor 
	                              0 => Sensor is not connected to bench,Resim is not executed for that Sensor Position -->
	<SENSOR_CONNECTION_STATUS>
		<REAR_LEFT>0</REAR_LEFT>
		<REAR_RIGHT>0</REAR_RIGHT>
		<FRONT_RIGHT>0</FRONT_RIGHT>
		<FRONT_LEFT>1</FRONT_LEFT>
		
		<BPR_RIGHT>0</BPR_RIGHT> <!-- BPILLAR RIGHT CENTER IP 77-->
		<BPR_LEFT>0</BPR_LEFT> <!-- BPILLAR LEFT CENTER IP 78-->
	
		<RADAR_ECU>0</RADAR_ECU>
	</SENSOR_CONNECTION_STATUS>
	
	
	<!-- Adding the dvsu path to take input log from that file path -->
	<!-- If same folder has series 001/002/003/etc , then Hil will run for all sets -->
	
	<!--INPUT_FILES>
		<FILE_PATH_1>D:\Ritesh\A310_Logs\Mid_Logs\ECU_3_9_2_SENS_3_9_3_SRR_DEBUG_WBATR91070LC63638_20191128_162334_deb_0005.MF4</FILE_PATH_1>	
		<!--FILE_PATH_2>D:\Ritesh\A310_Logs\Mid_Logs\ECU_3_9_2_SENS_3_9_3_SRR_DEBUG_WBATR91070LC63638_20191128_162334_deb_0005.MF4</FILE_PATH_2-->	
	<!--/INPUT_FILES -->	
	
	 <!-- Input Mode Options available are - 
	SIX_DVSU_INPUT : SIX dvsu enabled to handle six  input DVSU file ,proceed hil with 6 dvsu's file.(default option)
	FOUR_DVSU_INPUT : FOUR dvsu enabled to handle four  input DVSU file ,proceed hil with 4 dvsu's file.(default option)
	SINGLE_DVSU_INPUT: Single dvsu enabled to handle Single input DVSU file , proceed hil with Single dvsu file
	MDF4_INPUT :  MDF4_DVSU_ENABLED to handle MDF4 file proceed hil with mdf4 file -->
	<INPUT_OPTIONS>MDF4_INPUT</INPUT_OPTIONS>
	
	<!--To define whether the HiL execution should happen in a continuous mode(i.e Executing series of log) or execution of single set of log
		The option's available are : YES => Runs all the series of log in the folder based on the path provided
									  NO => Runs only one log even though there is series of logs-->
	<CONTINUOUS_RUN_MODE>NO</CONTINUOUS_RUN_MODE>
	
	
	
	<!-- To define the number of times the LOG must be Executed.-->
	<LOG_REPEAT_COUNT>None</LOG_REPEAT_COUNT>
	
	<!--UDP or CAN-->
	<VEHICLE_DATA_SOURCE>CAN</VEHICLE_DATA_SOURCE>
	
	<!--UDP or CAN-->
	<FUSION_DETECTION_SOURCE>CAN</FUSION_DETECTION_SOURCE>		
	
	<!--To define whether to close Command window automatically after HiL Execution : YES => Close Command window automatically after execution
																				    : NO  => Wait for user to Press Enter-->
	<AUTOCLOSE_COMMAND_WIN>NO</AUTOCLOSE_COMMAND_WIN>
	
	
	<!-- To define the CUSTOMER for which the HIL MODE is Executed. 
	Options available are: LOG_SIMULATION = 1, LIVE_SIMULATION = 2  -->
    <INPUT_DATA_TYPE>None</INPUT_DATA_TYPE>
	
	<!-- To define the CUSTOMER for which mode the radars are working. 
		 Options available are: DETECTION = 1, TRACKER = 2 -->
		 <!-- TRACKER/FEATURE_FUNCTION-->
	<SENSOR_RUN_MODE>None</SENSOR_RUN_MODE>
	
	<!--Whether the HiL execution should Run Radar Algorithms without Fusion or With Fusion
		The option's available are : YES => Runs Radar Algorithms with Fusion
									  NO => Runs Radar Algorithms without Fusion -->
	<RADAR_FUSION_ENABLED>YES</RADAR_FUSION_ENABLED>
	
	<!-- KPI_OUTPUT -- To enable statistics for HiL execution, available options are
		DISABLED: KPI will not be printed after successful HiL execution
		ENABLED: KPI will be printed after successful HiL execution -->
	<KPI_OUTPUT>321hpi</KPI_OUTPUT> 
	
	<!-- RESIM_EXECUTION_MODE
		NORMAL: Resim.exe will exit if initial connection with sensors is not established.
		IDLE: Resim.exe will go into idle mode and will stay operational -->
	<RESIM_EXECUTION_MODE>IDLE</RESIM_EXECUTION_MODE>
	
	<!-- DEBUGGING_HIL
		ENABLED : Resim.exe creates text file named as "HiL_Debugging.txt" and starts writing, debugging info to the file
		DISABLED: Resim.exe will not be create a "HiL_Debugging.txt" text file   -->
	<DEBUGGING_HIL>DISABLED</DEBUGGING_HIL>
	
	<UDP_PORT_DATA>6001</UDP_PORT_DATA>
	<UDP_PORT_XCP>4410</UDP_PORT_XCP>
	<UDP_PORT_LOGGING>5555</UDP_PORT_LOGGING>
	
	<INTERFACE_PORT>5544</INTERFACE_PORT>
	
	<!-- TOBJECT_INJECTION_TYPE parameter can be used to select the track injection based on the user input
		DSPACE: DSPACE ASM objects Injection
		INTERNAL: Objects injection from csv -->
	<TOBJECT_INJECTION_TYPE>None</TOBJECT_INJECTION_TYPE>	
	
	<!-- To define the CUSTOMER for which IP Address and port number the SCALEXIO/Scene Generator,HIL_Engine is running. -->
     <HIL_ENGINE_IP>192.168.1.41</HIL_ENGINE_IP>
	 
    <SCALEXIO_IP>192.168.1.90</SCALEXIO_IP>
	
	<SCALEXIO_PORT>5556</SCALEXIO_PORT>
	
	<!--To define which fault has to be injected :BLOCKAGE =>  Set the sensors to blockage
												 :ALIGNMENT => Injects Alignment fault to the sensors 
												 :NOTE      => Make the field empty if no faults need to be injected -->
	<FAULT_INJECTION></FAULT_INJECTION>
	
		<SET_FAULT_FROM>0</SET_FAULT_FROM> <!-- Provide the scan-index from which fault has to be injected -->
		<SET_FAULT_TILL>0</SET_FAULT_TILL> <!-- Provide the scan-index till which fault has to be injected -->
			
		<INJECT_FAULT_SENSOR_RL>0</INJECT_FAULT_SENSOR_RL> <!-- Provide 1 to enable fault injection for Rear Left sensor or make it empty-->
		<INJECT_FAULT_SENSOR_RR>0</INJECT_FAULT_SENSOR_RR> <!-- Provide 1 to enable fault injection for Rear Left sensor or make it empty-->	
	
</HIL_SRR5_Configuration>