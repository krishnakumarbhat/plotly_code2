    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "(gdb) Launch as root",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ApplicationProjects/APT_SRR_RESIM/output/Linux/Debug/APT_SRR_RESIM",
            "args": [
                "/home/kiran22ns1b/wkspUbuntu24/wslResimConf/SIL_XML/SIL_Engine_Config_Adcam.xml",
                "/home/kiran22ns1b/wkspUbuntu24/wslResimConf/silFileLists/SIL_Flist_Adcam.txt",
                "/home/kiran22ns1b/wkspUbuntu24/wslResimOutput"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}/ApplicationProjects/APT_SRR_RESIM/output/Linux/Debug",
            "environment": [{
                "name": "LD_LIBRARY_PATH",
                "value": "${workspaceFolder}/ApplicationProjects/APT_SRR_RESIM/output/Linux/Debug"
            }, {
                "name": "DEBUGINFOD_URLS",
                "value": ""
            }],
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/.vscode/gdb-wrapper.sh",
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },

        {
            "name": "(gdb) Attach to root process",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/ApplicationProjects/APT_SRR_RESIM/output/Linux/Debug/APT_SRR_RESIM",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },

        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/ApplicationProjects/APT_SRR_RESIM/output/Linux/Debug/APT_SRR_RESIM",
