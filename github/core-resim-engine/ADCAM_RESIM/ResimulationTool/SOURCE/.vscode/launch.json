            "program": "${workspaceFolder}/ApplicationProjects/APT_SRR_RESIM/output/x64/Debug/APT_SRR_RESIM.exe",
            "args": [
                "C:\\Kiran_KR_Sys\\Resim_CONFIG\\SIL_XML\\SIL_Engine_Config_Adcam.xml",
                "C:\\Kiran_KR_Sys\\Resim_File_List\\file_list_adcam.json",
