			            Options available for variant HONDA  - RADAR_HONDA_PCAN -->
          <CANDECODER>RADAR_HONDA_PCAN</CANDECODER>
        </INFO>
	 </VARIANT>
	 </INFO>
	<INFO KEY="STELLANTIS">
