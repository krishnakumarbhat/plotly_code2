          <CANDECODER>FLR4P_SOMEIP</CANDECODER>
        </INFO>
		<INFO KEY="Scale1">
          <!-- To define the CAN decoder for which the Bordnet is Executed. 
			            Options available for variant STLA  - FLR4P_SOMEIP -->
          <CANDECODER>SCALE1_VCAN_ETH</CANDECODER>
        </INFO>
	 </VARIANT>
	 </INFO>
	<INFO KEY="BMW_SP25">
      <!-- Options available are I_290,I_330,I_360,I_380,I_390,I_400. I_420, I_430, I_440  -->
      <VERSION>I_400</VERSION>

