      <VERSION>A_480</VERSION>

      <!-- Options available are : BMW_LOW,BMW_MID,BMW_HIGH -->
      <VARIANT KEY="BMW_LOW">
        <INFO KEY="BMW_LOW">
          <!-- To define the CAN decoder for which the Bordnet is Executed. 
			            Options available for variant LOW  - RADAR_PCAN, RADAR_SCAN, RADAR_VCAN, ALL
                  Option ALL to generate XML files for all CAN decoders in that variant -->
          <CANDECODER>RADAR_PCAN</CANDECODER>
        </INFO>
        <INFO KEY="BMW_MID">
          <!-- To define the CAN decoder for which the Bordnet is Executed. 
			            Options available for variant MID  - RADAR_PCAN, ECU_VCAN, ECU_ETHERNET, ALL 
							    Option ALL to generate XML files for all CAN decoders in that variant -->
          <CANDECODER>ECU_VCAN</CANDECODER>
        </INFO>
        <INFO KEY="BMW_HIGH">
          <!-- To define the CAN decoder for which the Bordnet is Executed. 
			           Options available for variant HIGH - RADAR_B_PIL -->
          <CANDECODER>RADAR_B_PIL</CANDECODER>
        </INFO>
      </VARIANT>
    </INFO>
	<INFO KEY="MAN_SRR3">
