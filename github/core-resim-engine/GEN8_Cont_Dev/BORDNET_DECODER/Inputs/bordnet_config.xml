			            Options available for variant MAN  - RADAR_VCAN_FC, RADAR_VCAN_LEFT, RADAR_VCAN_RIGHT
                  Option ALL to generate XML files for all CAN decoders in that variant -->
          <CANDECODER>RADAR_VCAN_FC</CANDECODER>
        </INFO>
	 </VARIANT>
	 </INFO>
	<INFO KEY="NISSAN_SRR6">
	 <!-- Options available are MAN -->
      <VERSION>NISSAN</VERSION>
	   <!-- Options available are : SRR6_NISSAN -->
      <VARIANT KEY="SRR6_NISSAN">
        <INFO KEY="SRR6_NISSAN">
          <!-- To define the CAN decoder for which the Bordnet is Executed. 
			            Options available for variant NISSAN  - RADAR_NISSAN -->
          <CANDECODER>RADAR_NISSAN</CANDECODER>
        </INFO>
	 </VARIANT>
	 </INFO>
	<INFO KEY="HONDA_SRR6P">
	 <!-- Options available are HONDA -->
