      <VERSION>STLA</VERSION>
	   <!-- Options available are : SRR6P_STLA,FLR4_STLA,FLR4P_STLA, Scale1 -->
      <VARIANT KEY="Scale1">
        <INFO KEY="SRR6P_STLA">
          <!-- To define the CAN decoder for which the Bordnet is Executed. 
			            Options available for variant STLA  - RADAR_STLA_VCAN -->
          <CANDECODER>RADAR_STLA_VCAN</CANDECODER>
        </INFO>
		<INFO KEY="FLR4_STLA">
          <!-- To define the CAN decoder for which the Bordnet is Executed. 
			            Options available for variant STLA  - FLR4_ETHERNET -->
          <CANDECODER>FLR4_ETHERNET</CANDECODER>
        </INFO>
		<INFO KEY="FLR4P_STLA">
          <!-- To define the CAN decoder for which the Bordnet is Executed. 
