CM_ SG_ 163 STS_SW_VERSION_FIELD1 "Release_Number is incremented for major every release";
CM_ SG_ 163 STS_SW_VERSION_FIELD2 "Promote_Revision, increment with every promote or minor release";
CM_ SG_ 163 STS_SW_VERSION_FIELD3 "Field_Revision  or Variant number";
CM_ SG_ 163 STS_SW_VERSION_FIELD4 "Increment with SW patch release";
CM_ SG_ 163 STS_PBL_VERSION_FIELD1 "Release_Number is incremented for major every release";
CM_ SG_ 163 STS_PBL_VERSION_FIELD2 "Promote_Revision, increment with every promote or minor release";
CM_ SG_ 163 STS_PBL_VERSION_FIELD3 "Field_Revision  or Variant number";
CM_ SG_ 163 STS_PBL_VERSION_FIELD4 "Increment with patch release";
CM_ SG_ 163 STS_SMC_SECTION_COMPTBLITY "Section compatiblity bits as specified in EXEC spec";
CM_ SG_ 163 STS_SMC_PLATFROM_VERSION "Variant ID";
CM_ SG_ 163 STS_SENSOR_MOUNT_POS_X "Correction of the mounting position w.r.t. the optimal position. Correction is determined by calibration";
CM_ SG_ 163 STS_SENSOR_MOUNT_ORNT_PITCH "Correction of the mounting position orientation w.r.t. the optimal orientation";
CM_ SG_ 163 STS_SENSOR_HEIGHT "Radar height from ground to center of radar elevation field-of-view";
CM_ SG_ 163 STS_DET_DBC_BASE_VER_MINOR "Detection base dbc Minor version";
CM_ SG_ 163 STS_DET_DBC_BASE_VER_MAJOR "Detection base dbc Major version";
CM_ SG_ 160 HED_NUM_OF_VALID_DETECTIONS "The current number of valid detections in the detections list";
CM_ SG_ 160 HED_INTRFC_VERSION_ID_MAJOR "Version number for major";
CM_ SG_ 160 HED_INTRFC_VERSION_ID_MINOR "Version number for minor";
CM_ SG_ 160 HED_INTRFC_VERSION_ID_PATCH "Version number for patch";
CM_ SG_ 160 HED_LOOK_ID "Indicates the look type values 1 to 4 base on medium/long look and near/far look. Each radar scan is a look.";
CM_ SG_ 160 HED_SCAN_INDEX "Scan index";
CM_ SG_ 160 HED_MH_CYCLE_COUNTER "ALIVE counter";
CM_ SG_ 160 HED_DATA_QUALIFIER "Data qualifier communicates the overall availability of the interface or expresses to what extent the content of this event can be relied on ";
CM_ SG_ 160 HED_DET_RANGE_MAX "Detection range max is the farthest possible detection with respect to the sensor origin.";
CM_ SG_ 160 HED_DET_SPEED_RANGE_MAX "Describes the relative radial speed range in the sensor coordinate system. Range is defined by
two range values: negative values indicate lower speed than the ego-vehicle, positive values
indicate higher velocity than ego-vehicle";
CM_ SG_ 160 HED_FOV_HOR_MAX "Field of view defined by opening angles in sensor XY-plane.";
CM_ SG_ 160 HED_FOV_VER_MAX "Field of view defined by opening angles in sensor XZ-plane.";
CM_ SG_ 160 HED_DET_RANGE_MIN "Detection range max is the Closest possible detection with respect to the sensor origin.";
CM_ SG_ 160 HED_DET_SPEED_RANGE_MIN "Describes the relative radial speed range in the sensor coordinate system. Range is defined by
two range values: negative values indicate lower speed than the ego-vehicle, positive values
indicate higher velocity than ego-vehicle";
CM_ SG_ 160 HED_FOV_HOR_MIN "Field of view defined by opening angles in sensor XY-plane.";
CM_ SG_ 160 HED_FOV_VER_MIN "Field of view defined by opening angles in sensor XZ-plane.";
CM_ SG_ 160 HED_ALIGN_HOR_REF "Alignment horizontal reference";
CM_ SG_ 160 HED_ALIGN_HOR_QF "Alignment horizontal calibration status";
CM_ SG_ 160 HED_AF_TIME_PEAK "Angle Finding Latency peak";
CM_ SG_ 160 HED_AF_TIME_INST "Angle Finding Latency instantaneous";
CM_ SG_ 160 HED_SENSOR_TIME_STAMP_NS "sensor absolute time when the radar measurement was taken";
CM_ SG_ 160 HED_TIME_SYNC_SRC_MASTER "Indicate if sensor is synch to global master or local master";
CM_ SG_ 160 HED_TIME_SYNC_VALIDITY_FLAG "indicates the validity of Time Sync message data";
CM_ SG_ 160 HED_TRIGGER_TIME "Data Acquisition start time";
