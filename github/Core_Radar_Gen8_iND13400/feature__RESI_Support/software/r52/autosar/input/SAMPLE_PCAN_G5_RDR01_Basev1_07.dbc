CM_ SG_ 2 SSTS_VEHICLE_SPEED_CALC_QF "Speed Quality factor";
CM_ SG_ 2 SSTS_VEH_BATT_VOLT "absolute battery voltage";
CM_ SG_ 2 SSTS_PWPCKTQ_D_STAT "Indicates if the power pack is a motive (wheel torque producing) or non-motive (non-wheel torque producing) mode. It also indicates to if a transition from a non-motive to a motive mode is in progress.";
CM_ SG_ 2 SSTS_CC_STAT_D_ACTL "Status of cruise  controls.";
CM_ SG_ 2 SSTS_ElPW_D_STAT "Indicates if the power pack is supporting the 12V bus with energy, supporting but about to stop, not supporting and undergoing a large power draw (e.g. starting MHEV ICE), or in a fault limited support mode.";
CM_ SG_ 2 SSTS_VEHOVERGND_V_EST "Estimated vehicle speed over ground.";
CM_ SG_ 2 SSTS_STEERING_ANGLE_SIGN "Actual steering angle direction, from the centre position of the steering wheel.";
CM_ SG_ 2 SSTS_STEERING_ANGLE "Actual steering wheel angle. Datum (zero) of the steering wheel position is determined at the time of calibration in the factory.   This is only the magnitude of the steering wheel angle.";
CM_ SG_ 323 OBJ_ALIVE_TIME_004 "Time since object initialization in msec. Tracker internal may have bigger values. On the output interface, we should saturate the signal in that case.";
CM_ SG_ 323 OBJ_ACCELERATION_LONG_ERR_004 "acceleration along Longi  direction";
CM_ SG_ 323 OBJ_ACCELERATION_LAT_ERR_004 "acceleration along Lat direction error";
CM_ SG_ 323 OBJ_POS_LONG_ERR_004 "Lat-position error of object track's centroid in VCS coordinate";
CM_ SG_ 323 OBJ_POS_LAT_ERR_004 "Lat-position error of object track's centroid in VCS coordinate";
CM_ SG_ 323 OBJ_TRACK_MOTION_MODEL_004 "Object tracking uses a motion model for tracking moving items";
CM_ SG_ 323 OBJ_DIMENSION_WIDTH_004 "Lat distance from centroid to edge of bounding box.";
CM_ SG_ 323 OBJ_DIMENSION_LENGTH_004 "Longi distance from centroid to edge of bounding box.";
CM_ SG_ 323 OBJ_EXISTENCE_PROB_004 "Probability that the target is an actual target";
CM_ SG_ 323 OBJ_YAW_ANGLE_004 "Orientation of track's bounding box in VCS coordinate";
CM_ SG_ 323 OBJ_ID_004 "ID of object tracks, zero-ID represents an inactive track";
CM_ SG_ 323 OBJ_MOVEMENT_STATUS_004 "Information about a possible movement of the object during tracking";
CM_ SG_ 323 OBJ_MEASUREMENT_STATUS_004 "Objects should be sent out as fast as possible, even if not all statuses are observed and the object’s
signals might not be fully filled.";
CM_ SG_ 323 OBJ_POS_LONG_004 "Long-position of object track's centroid in VCS coordinate";
CM_ SG_ 323 OBJ_POS_LAT_004 "Lat-position of object track's centroid in VCS coordinate";
CM_ SG_ 323 OBJ_VELOCITY_LONG_004 "Over-the-ground velocity of object track's centroid along Long direction (in VCS coordinate)";
CM_ SG_ 323 OBJ_VELOCITY_LAT_004 "Over-the-ground velocity of object track's centroid along Lat direction (in VCS coordinate)";
CM_ SG_ 323 OBJ_ACCELERATION_LONG_004 "Over-the-ground track acceleration along Longi direction (in VCS coordinate)";
CM_ SG_ 323 OBJ_ACCELERATION_LAT_004 "Over-the-ground track acceleration along Lat direction (in VCS coordinate)";
CM_ SG_ 323 OBJ_VEH_TRACK_FLAG_004 "Indicates if current track is a vehicle";
CM_ SG_ 323 OBJ_TIMESTAMP_OFFSET_004 "A timestamp offset from the object list header timestamp for each object as we have different timestamps from different sensors leading to different timestamps on each object";
CM_ SG_ 323 OBJ_DIMENSION_WIDTH_ERR_004 "Lat distance or length error";
CM_ SG_ 323 OBJ_DIMENSION_LENGTH_ERR_004 "Longi distance or length error";
CM_ SG_ 323 OBJ_CLS_TYPE1_004 "Classification Type 1(Highest Prob), selected from ENUM list";
CM_ SG_ 323 OBJ_CLS_TYPE1_PROB_004 "Classification Type 1 probablity";
CM_ SG_ 323 OBJ_CLS_TYPE6_004 "Classification Type 6(Lowest Prob), selected from ENUM list";
CM_ SG_ 323 OBJ_CLS_TYPE6_PROB_004 "Classification Type 1 probablity";
CM_ SG_ 323 OBJ_RCS_004 "Representative RCS of the complete recognized object, Not implemented";
CM_ SG_ 323 OBJ_REF_PT_LONG_OFFSET_004 "Outer edges of the recognized object’s bounding box in Y axis";
CM_ SG_ 323 OBJ_REF_PT_LAT_OFFSET_004 "Outer edges of the recognized object’s bounding box in X axis";
CM_ SG_ 323 OBJ_YAW_RATE_004 "Orientation rate of track's bounding box in VCS coordinate";
CM_ SG_ 323 OBJ_GROUP_ID_004 "Objects which are linked together shall have same group ID";
CM_ SG_ 323 OBJ_POS_ERR_CRR_COEF_004 "vx-vy correlation due to small error in radial direction and big in cross radial - position Correlation Coefficient Error";
CM_ SG_ 323 OBJ_VELOCITY_ERR_CRR_COEF_004 "vx-vy correlation due to small error in radial direction and big in cross radial - velocity Correlation Coefficient Error";
CM_ SG_ 323 OBJ_ACCEL_ERR_CRR_COEF_004 "vx-vy correlation due to small error in radial direction and big in cross radial - Acceleration Correlation Coefficient Error";
