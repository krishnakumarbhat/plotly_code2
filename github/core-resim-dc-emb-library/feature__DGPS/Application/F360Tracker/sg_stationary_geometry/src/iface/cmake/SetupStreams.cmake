# Macro: setup_streams
# Description:
#   setup streams numbers
macro(setup_streams)
    if(SG_VARIANT STREQUAL SCANIA_TRATON)
        set(SG_STREAM_OUTPUT_MINOR          9)
        set(SG_STREAM_REDUCED_OUTPUT_MINOR  11)
        set(SG_STREAM_INTERNALS_MINOR       22)
    elseif(SG_VARIANT STREQUAL PLATFORM_REDUCED)
        set(SG_STREAM_OUTPUT_MINOR          10)
        set(SG_STREAM_REDUCED_OUTPUT_MINOR  10)
        set(SG_STREAM_INTERNALS_MINOR       20)
    elseif(SG_VARIANT STREQUAL PLATFORM_UNLIMITED)
        set(SG_STREAM_OUTPUT_MINOR          10)
        set(SG_STREAM_REDUCED_OUTPUT_MINOR  10)
        set(SG_STREAM_INTERNALS_MINOR       16)
    elseif(SG_VARIANT STREQUAL PLATFORM_HIGH)
        set(SG_STREAM_OUTPUT_MINOR          11)
        set(SG_STREAM_REDUCED_OUTPUT_MINOR  10)
        set(SG_STREAM_INTERNALS_MINOR       17)
    elseif(SG_VARIANT STREQUAL PLATFORM_MEDIUM)
        set(SG_STREAM_OUTPUT_MINOR          10)
        set(SG_STREAM_REDUCED_OUTPUT_MINOR  10)
        set(SG_STREAM_INTERNALS_MINOR       18)
    elseif(SG_VARIANT STREQUAL PLATFORM_LOW)
        set(SG_STREAM_OUTPUT_MINOR          12)
        set(SG_STREAM_REDUCED_OUTPUT_MINOR  10)
        set(SG_STREAM_INTERNALS_MINOR       19)
    else()
        set(SG_STREAM_OUTPUT_MINOR          10)
        set(SG_STREAM_REDUCED_OUTPUT_MINOR  10)
        set(SG_STREAM_INTERNALS_MINOR       21)
    endif()

    set(SG_STREAM_OUTPUT_MAJOR          180)
    set(SG_STREAM_TIMING_MAJOR          181)
    set(SG_STREAM_INTERNALS_MAJOR       182)
    set(SG_STREAM_REDUCED_OUTPUT_MAJOR  183)

    set(SG_STREAM_TIMING_MINOR 4)
endmacro()