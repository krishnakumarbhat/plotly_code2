{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "g++-7 - Build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/x64/SensorModelSilEngine",
            "args": ["${workspaceFolder}/Config/VVEngineConfig.yaml", "${workspaceFolder}/Blist_file.txt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/output/x64",
            "environment": [{"name": "LD_LIBRARY_PATH", "value": "${workspaceFolder}/output/x64"}],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}