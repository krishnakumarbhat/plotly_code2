        <!-- OSI input of the LiME-receiver FMU described by id, IP & portnumber communicating with the counterpart defined in osi-visualizer/LiME-Juicer -->
        <Receiver Id="0" CommunicationType="zmq" DataType="SensorView">
            <Ip>127.0.0.1</Ip>
            <Port>5564</Port>
            <Pattern>Push-Pull</Pattern><!--Pattern>Push-Pull</Pattern-->
            <ConnectTo Element="Model" Id="0" InputPort="0"/>
	    <ConnectTo Element="Model" Id="1" InputPort="0"/>
